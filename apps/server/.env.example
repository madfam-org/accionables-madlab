# Placeholder-only template. Do not commit live school/student/contact data,
# CRM payloads, database URLs, Janua secrets, AI keys, GitHub tokens, or
# production credentials. Keep real values in an untracked local env file or
# the approved secret store.

# Local side-effect guards. Set these only in your shell when intentionally
# running local services, database mutations, or destructive cleanup.
LOCAL_SERVICES=no
LOCAL_DB=no
LOCAL_DESTRUCTIVE=no

# Environment
NODE_ENV=development

# Server
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=replace-with-local-or-secret-store-database-url
POSTGRES_USER=madlab_local
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=madlab

# CORS (Comma-separated origins for production)
ALLOWED_ORIGINS=https://madlab.app,https://app.madlab.io

# Janua IdP Integration
# Required in production. If unset, verifyJWT fails closed with 500.
# In development, you can leave these unset and use the dev-mock token
# `Bearer dev-token-mock-user` to call protected endpoints.
JANUA_ISSUER=https://auth.madfam.io
JANUA_AUDIENCE=madlab-api
JANUA_JWKS_URI=https://auth.madfam.io/.well-known/jwks.json

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Choose ONE provider: ollama | groq | together | custom | mock (default)
AI_PROVIDER=mock

# -----------------------------------------------------------------------------
# Option 1: Ollama (Local - FREE, Private)
# -----------------------------------------------------------------------------
# Run open-source models locally. Requires Ollama installed.
# Install: https://ollama.ai
# Models: llama3.2, mistral, mixtral, qwen2.5, deepseek-coder, etc.
#
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Option 2: Groq (API - FREE tier, Very Fast)
# -----------------------------------------------------------------------------
# Fastest inference for open models. Free tier: 30 req/min
# Get API key: https://console.groq.com
# Models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
#
# AI_PROVIDER=groq
# GROQ_API_KEY=replace-with-groq-api-key
# GROQ_MODEL=llama-3.1-70b-versatile

# -----------------------------------------------------------------------------
# Option 3: Together.ai (API - Pay per token)
# -----------------------------------------------------------------------------
# Wide model selection, competitive pricing
# Get API key: https://api.together.xyz
# Models: meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo, mistralai/Mixtral-8x7B-Instruct-v0.1
#
# AI_PROVIDER=together
# TOGETHER_API_KEY=replace-with-together-api-key
# TOGETHER_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo

# -----------------------------------------------------------------------------
# Option 4: Custom (BYOK - Any OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# Use any OpenAI-compatible API (vLLM, LocalAI, LM Studio, etc.)
#
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:8000/v1
# AI_API_KEY=replace-with-provider-api-key-if-needed
# AI_MODEL=your-model-name
