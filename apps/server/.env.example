# Placeholder-only template. Do not commit live school/student/contact data,
# CRM payloads, database URLs, Janua secrets, AI keys, GitHub tokens, or
# production credentials. Keep real values in an untracked local env file or
# the approved secret store.

# Local side-effect guards. Set these only in your shell when intentionally
# running local services, database mutations, or destructive cleanup.
LOCAL_SERVICES=no
LOCAL_DB=no
LOCAL_DESTRUCTIVE=no

# Environment
NODE_ENV=development

# Server
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=replace-with-local-or-secret-store-database-url
POSTGRES_USER=madlab_local
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=madlab

# CORS (Comma-separated origins for production)
ALLOWED_ORIGINS=https://madlab.app,https://app.madlab.io

# Janua IdP Integration
# Required in production. If unset, verifyJWT fails closed with 500.
# In development, you can leave these unset and use the dev-mock token
# `Bearer dev-token-mock-user` to call protected endpoints.
JANUA_ISSUER=https://auth.madfam.io
JANUA_AUDIENCE=madlab-api
JANUA_JWKS_URI=https://auth.madfam.io/.well-known/jwks.json

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Choose ONE provider: selva | mock (default)
#
# STANDING PROHIBITION 2: no direct LLM provider calls — everything routes
# through Selva's OpenAI-compatible /v1 (the ecosystem chokepoint for model
# policy, billing, and audit). 'mock' needs no key: local dev and CI stay
# hermetic.
AI_PROVIDER=mock

# AI_PROVIDER=selva
# SELVA_BASE_URL=https://inference.selva.town/v1
# SELVA_API_KEY=replace-with-selva-api-key
# SELVA_MODEL=selva-default
